{
  "name": "presprog/my-kirby-plugin",
  "description": "Describe your plugin here",
  "license": "MIT",
  "type": "kirby-plugin",
  "authors": [
    {
      "name": "Benedict Massolle",
      "email": "bm@presentprogressive.de",
      "homepage": "https://presentprogressive.de"
    }
  ],
  "require": {
    "getkirby/composer-installer": "^1.2",
    "php": "^8.4"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.9",
    "getkirby/cms": "^5.0",
    "phpunit/phpunit": "^12.5",
    "symfony/console": "^7.0"
  },
  "conflict": {
    "getkirby/cms": "<5.0"
  },
  "autoload": {
    "psr-4": {
      "PresProg\\MyPlugin\\": "classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PresProg\\MyPlugin\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true,
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "forward-command": true,
      "target-directory": "tools"
    },
    "installer-name": "my-plugin",
    "kirby-cms-path": false
  },
  "scripts": {
    "plugin:init": "PresProg\\MyPlugin\\InitCommand",
    "analyze": [
      "@composer-validate",
      "@cscheck",
      "@psalm",
      "@tests"
    ],
    "composer-validate": "composer validate --strict --no-check-version --no-check-all",
    "cscheck": "@php tools/phpcs/vendor/bin/php-cs-fixer check --diff",
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "psalm": "@php tools/psalm/vendor/bin/psalm",
    "tests": "phpunit",
    "tests:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html=tests/coverage"
  }
}
