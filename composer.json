{
  "name": "presprog/my-kirby-plugin",
  "description": "Describe your plugin here",
  "license": "MIT",
  "type": "kirby-plugin",
  "authors": [
    {
      "name": "Benedict Massolle",
      "email": "bm@presentprogressive.de",
      "homepage": "https://presentprogressive.de"
    }
  ],
  "require": {
    "getkirby/composer-installer": "^1.2",
    "getkirby/cms": "^5.0",
    "php": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "PresProg\\MyPlugin\\": "classes/"
    }
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true
  },
  "extra": {
    "installer-name": "my-plugin",
    "kirby-cms-path": false
  },
  "scripts": {
    "plugin:init": "@php tools/init.php",
    "analyze": [
      "@composer-validate",
      "@cscheck",
      "@psalm",
      "@tests"
    ],
    "composer-validate": "composer validate --strict --no-check-version --no-check-all",
    "cscheck": "@php tools/phpcs/vendor/bin/php-cs-fixer check --diff",
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "psalm": "@php tools/psalm/vendor/bin/psalm",
    "tests": "@php tools/phpunit/vendor/bin/phpunit",
    "tests:coverage": "XDEBUG_MODE=coverage tools/phpunit/vendor/bin/phpunit --coverage-html=tests/coverage",
    "tools": "@php tools/tools.php"
  }
}
