{
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "kirbyup panel/index.js --watch",
    "serve": "kirbyup serve panel/index.js",
