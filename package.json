  "devDependencies": {
    "happy-dom": "^17.6.3",
    "kirbyup": "3.4.1",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  }
